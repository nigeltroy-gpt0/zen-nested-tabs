[
  {
    "property": "mod.nestedtabs.auto_nest",
    "label": "Nest tabs opened from a link under the tab that opened them",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.nestedtabs.indent",
    "label": "Indent per nesting level, in px (4–64)",
    "type": "string",
    "placeholder": "16",
    "defaultValue": "16"
  },
  {
    "property": "mod.nestedtabs.caret_position",
    "label": "Expand/collapse caret position",
    "type": "dropdown",
    "placeholder": false,
    "defaultValue": "edge",
    "options": [
      {
        "label": "Far right, after the close button",
        "value": "edge"
      },
      {
        "label": "Right, before the close button",
        "value": "right"
      },
      {
        "label": "Left, before the icon",
        "value": "left"
      }
    ]
  },
  {
    "property": "mod.nestedtabs.show_guides",
    "label": "Show faint indent guide lines",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.nestedtabs.show_count",
    "label": "Show the number of hidden tabs on collapsed parents",
    "type": "checkbox",
    "defaultValue": true
  },
  {
    "property": "mod.nestedtabs.close_behavior",
    "label": "When closing a parent tab",
    "type": "dropdown",
    "placeholder": "Select behavior",
    "defaultValue": "promote",
    "options": [
      {
        "label": "Close the whole tree",
        "value": "close_all"
      },
      {
        "label": "Close the whole tree, only if collapsed",
        "value": "close_collapsed"
      },
      {
        "label": "Move children up one level",
        "value": "promote"
      }
    ]
  }
]
